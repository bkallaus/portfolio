{
  "name": "ben-kallaus-me",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "description": "Every page on ben.kallaus.me, in one repo, deployed as one GitHub Pages artifact.",
  "homepage": "https://ben.kallaus.me",
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "build:nav": "node packages/nav/build.mjs",
    "preview": "vite preview --outDir dist",
    "dev": "vite",
    "test": "vitest run",
    "lint": "eslint apps",
    "test:musical-cards": "vitest run --project musical-cards",
    "test:quick": "vitest run --project quick",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "walkthrough": "node scripts/record-walkthrough.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@pkmn/client": "^0.7.2",
    "@pkmn/data": "^0.10.7",
    "@pkmn/dex": "^0.10.7",
    "@pkmn/randoms": "^0.10.7",
    "@pkmn/sim": "^0.10.7",
    "@smogon/calc": "^0.11.0",
    "chance": "^1.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.27.0",
    "lucide-react": "^1.39.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.0.1",
    "react-number-format": "^5.4.5",
    "styled-components": "^6.1.8",
    "tailwind-merge": "^3.6.0",
    "tone": "^15.1.22",
    "use-local-storage": "^3.0.0",
    "vexflow": "^4.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jest-canvas-mock": "^2.5.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.2.5",
    "sass": "^1.42.1",
    "shadcn": "^4.17.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "underscore": "1.13.8",
    "body-parser": "1.20.6"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
